# saidas de compilacao
build/
lib/
backup/
*.exe
*.o
*.a
*.ppu
*.rsj
*.compiled
*.dcu
*.res
Win32/
Win64/
linux/
# Android: o IDE gera a arvore do APK (classes.dex, CompiledResources, o
# AndroidManifest.xml JA resolvido) dentro de Android64/<Config>. O template
# versionado e o AndroidManifest.template.xml na raiz do projeto, nao este.
#
# A saida da plataforma Android 32 bits chama-se so 'Android', que colidiria com
# o diretorio tests/Android (a suite de device). Por isso os caminhos aqui sao
# explicitos em vez de um 'Android/' solto.
Android64/
samples/EchoAndroid/Android/
tests/Android/Android/
# gerado pelo gerenciador de Deployment a partir da secao <Deployment> do .dproj
*.deployproj

# binarios ELF (sem extensao) gerados por lazbuild/fpc em Linux
tests/Unit/fpc/PipesUnitTestsFpc
tests/Integration/fpc/PipesIntegrationTestsFpc

# arquivos de sessao/IDE
*.lps
*.local
*.identcache
*.stat
__history/
__recovery/
packagefiles.xml

# segredos de PKI/mTLS gerados por tools/gerar-pki.sh (nunca versionar; a
# PKI de teste em tests/pki ja esta rastreada e nao e afetada por isto)
*.pfx
*_key.pem
senha-pfx.txt
/tools/*/
